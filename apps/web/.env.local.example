NEXT_PUBLIC_SUPABASE_URL=https://eqoxfvrdsysptrdzruoe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-sb_publishable-key
AI_SERVICE_URL=http://localhost:8000

# Server-only. Needed for logging in with a username. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-sb_secret-key

# Video calls (LiveKit Cloud project > Settings > Keys). LIVEKIT_URL is the
# wss:// address browsers connect to. The key and secret are server-only.
# Never prefix them with NEXT_PUBLIC_.
LIVEKIT_URL=wss://replace-with-your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Server-only. Must match AI_SERVICE_INTERNAL_TOKEN in services/ai/.env so the
# web server can start document text extraction. Never prefix with NEXT_PUBLIC_.
AI_SERVICE_INTERNAL_TOKEN=replace-with-the-same-random-token-as-the-ai-service
